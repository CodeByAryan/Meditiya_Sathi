# Copy this file to `.env` and fill in your values.

# --- PostgreSQL (required) ---
# Local example: postgresql://postgres:password@localhost:5432/meditiya_sathi
# Free cloud option: https://neon.tech or https://supabase.com
DATABASE_URL=

# --- API server (port 8080) ---
PORT=8080
NODE_ENV=development
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# --- Frontend (Vite reads VITE_* vars) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# Leave empty for local development
VITE_CLERK_PROXY_URL=

# Server-side Cloudinary credentials for event image uploads. Never prefix
# these with VITE_ or expose them to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
